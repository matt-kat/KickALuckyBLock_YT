{
    "$schema": "https://bridge.playgama.com/v2/stable/schema.json",
    "disableLoadingLogo": true,
    "game": {
        "adaptToSafeArea": true
    },
    "device": {
        "useBuiltInOrientationPopup": false,
        "supportedOrientations": [
            "portrait",
            "landscape"
        ]
    },
    "advertisement": {
        "interstitial": {
            "preloadOnStart": true
        },
        "rewarded": {
            "preloadOnStart": true
        },
        "useBuiltInErrorPopup": false,
        "backfillId": ""
    },
    "payments": [],
    "leaderboards": [
        {
            "id": "main_score",
            "isMain": true
        }
    ],
    "sendAnalyticsEvents": false
}
